---
import '../styles/global.css';
import Sidebar from '../components/Sidebar.astro';
import SiteFooter from '../components/SiteFooter.astro';
import { SITE, asset } from '../data/site';

interface Props {
  title?: string;
  description?: string;
  /** 追加到 <title> 前的页面前缀 */
  pageTitle?: string;
}

const {
  pageTitle,
  title = pageTitle ? `${pageTitle} · ${SITE.title}` : SITE.title,
  description = SITE.description,
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site).href;
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="color-scheme" content="dark" />
    <meta name="theme-color" content="#0e0709" />
    <meta name="generator" content={Astro.generator} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE.title} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:locale" content="zh_CN" />

    <link rel="icon" type="image/svg+xml" href={asset('favicon.svg')} />

    <!--
      字体 CDN（ZeoSeven Fonts）会对字面 IP 来源直接返回 204 空样式表，
      导致字体静默回退且控制台无报错。这里统一不带 Referer，
      使 localhost / 127.0.0.1 / 任意域名下的表现一致。
    -->
    <meta name="referrer" content="no-referrer" />
    <link rel="preconnect" href="https://fontsapi.zeoseven.com" crossorigin />
    <link rel="dns-prefetch" href="https://fontsapi.zeoseven.com" />
    <link
      rel="stylesheet"
      href="https://fontsapi.zeoseven.com/92/main/result.css"
      referrerpolicy="no-referrer"
    />
    <link
      rel="stylesheet"
      href="https://fontsapi.zeoseven.com/69/main/result.css"
      referrerpolicy="no-referrer"
    />
  </head>

  <body>
    <a class="skip-link" href="#main">跳到正文</a>
    <Sidebar />
    <div class="main" id="main">
      <slot />
      <SiteFooter />
    </div>

    <script>
      // QQ 群号复制：不含任何个人联系方式
      const toast = document.querySelector<HTMLElement>('[data-copy-toast]');
      let timer: number | undefined;

      const showToast = (text: string) => {
        if (!toast) return;
        toast.textContent = text;
        toast.setAttribute('data-show', '');
        window.clearTimeout(timer);
        timer = window.setTimeout(() => toast.removeAttribute('data-show'), 2200);
      };

      document.querySelectorAll<HTMLElement>('[data-copy-qq]').forEach((btn) => {
        btn.addEventListener('click', async () => {
          const value = btn.dataset.copyQq ?? '';
          try {
            await navigator.clipboard.writeText(value);
            showToast(`已复制 QQ 群号 ${value}`);
          } catch {
            showToast(`QQ 群号：${value}`);
          }
        });
      });
    </script>
  </body>
</html>
