---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import SectionHead from '../components/SectionHead.astro';
import VideoCard from '../components/VideoCard.astro';
import ProgramList from '../components/ProgramList.astro';
import MissingList from '../components/MissingList.astro';
import { FEATURE, OFFICIAL, ARCHIVE_STATS } from '../data/videos';
import { PROGRAM_STATS, HOSTS, MISSING } from '../data/program';
import { durationText, views } from '../lib/format';
import { ArrowRight, MonitorPlay, Mic } from '@lucide/astro';

const facts = [
  { label: '正片时长', value: durationText(ARCHIVE_STATS.featureDuration) },
  { label: 'B 站播放', value: views(ARCHIVE_STATS.featureViews) },
  { label: '收录单品', value: `${PROGRAM_STATS.count} 个` },
  { label: '参与作者', value: `${PROGRAM_STATS.contributors} 位` },
];
---

<BaseLayout
  pageTitle="2026 回看"
  description="SCP 基金会中文分部 2026 首届新春会正片、官方物料与完整节目单，含 B 站播放地址。"
>
  <PageHeader
    kicker="Archive · 2026"
    title="2026 首届新春会"
    lede={`第一届新春会于 2026 年除夕上线，全长 ${durationText(ARCHIVE_STATS.featureDuration)}，在 B 站获得 ${views(ARCHIVE_STATS.featureViews)}播放。本页归档正片、官方物料与主办方人工过片后确认的全部单品，可直接跳转到 B 站观看。`}
    facts={facts}
    mark="ceremony-2026"
    texture="asanoha"
  />

  <div class="shell">
    <section class="section">
      <SectionHead
        index="01"
        kicker="Feature"
        title="正片"
        note="全片在 B 站免费公开。若想先看节目单，正片简介与分 P 章节都有整理。"
      />
      <VideoCard video={FEATURE} variant="feature" />
      <p class="act">
        <a class="btn" href={FEATURE.url} target="_blank" rel="noopener noreferrer">
          <MonitorPlay size={15} stroke-width={1.6} />
          在 B 站观看正片
        </a>
      </p>
    </section>

    <section class="section">
      <SectionHead
        index="02"
        kicker="Official"
        title="官方发布"
        note="征稿公告、定档预告与新春贺词，均由主办方账号发布。"
      />
      <div class="grid grid--3">
        {OFFICIAL.map((v) => <VideoCard video={v} />)}
      </div>
    </section>

    <section class="section">
      <SectionHead
        index="03"
        kicker="Programme"
        title="节目单"
        note={`主办方人工过片后确认的单品共 ${PROGRAM_STATS.count} 项，其中 2 项由多条投稿合并或多个版本组成。按 B 站播放量降序排列，仅为浏览方便。标题逐字照搬投稿原样。`}
      />
      <ProgramList />
    </section>

    <section class="section">
      <SectionHead
        index="04"
        kicker="Unavailable"
        title="没有单独投稿的节目"
        note={`以下 ${MISSING.length} 个节目在正片中出现，但没有可跳转的单品地址——要么作者在 B 站有号却没单独发布，要么未能找到对应账号。列出它们是为了让节目单完整，不代表对作品的评价。`}
      />
      <MissingList />
    </section>

    <section class="section">
      <SectionHead index="05" kicker="Hosts" title="主持人" note="2026 首届新春会的两位主持。" />
      <ul class="hosts">
        {
          HOSTS.map((h) => (
            <li class="hosts__item">
              <span class="hosts__icon" aria-hidden="true">
                <Mic size={16} stroke-width={1.5} />
              </span>
              <a class="hosts__name" href={h.url} target="_blank" rel="noopener noreferrer">
                {h.name}
              </a>
              <span class="hosts__mid tnum">UID {h.mid}</span>
            </li>
          ))
        }
      </ul>
    </section>

    <section class="section">
      <SectionHead
        index="06"
        kicker="Next"
        title="下一届"
        note="2027 新春会的报名开放至 2026 年 10 月 31 日 23:59，作品交稿截止 2027 年 1 月 1 日 00:00。"
      />
      <div class="next">
        <a class="next__card" href="/2027/">
          <span class="micro">2027 筹备</span>
          <span class="next__title">查看本届进度</span>
          <span class="next__body">时间轴、主办方与倒计时。</span>
          <ArrowRight size={16} stroke-width={1.6} />
        </a>
        <a class="next__card" href="/join/">
          <span class="micro">投稿参与</span>
          <span class="next__title">查看投稿要求</span>
          <span class="next__body">交付格式、内容红线、节目类型与时长。</span>
          <ArrowRight size={16} stroke-width={1.6} />
        </a>
      </div>
    </section>
  </div>
</BaseLayout>

<style>
  .grid {
    display: grid;
    gap: 18px;
  }

  .grid--3 {
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }

  .act {
    margin-top: 22px;
  }

  /* ---- 主持人 ---- */
  .hosts {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    border-top: 1px solid var(--line);
    border-left: 1px solid var(--line);
  }

  .hosts__item {
    display: flex;
    align-items: center;
    gap: 14px;
    padding: 22px 20px;
    border-right: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
    transition: background-color var(--t);
  }

  .hosts__item:hover {
    background: var(--surface);
  }

  .hosts__icon {
    color: var(--gold);
  }

  .hosts__name {
    font-family: var(--font-display);
    font-size: 1.24rem;
    color: var(--fg);
    transition: color var(--t);
  }

  .hosts__item:hover .hosts__name {
    color: var(--gold-hi);
  }

  .hosts__mid {
    margin-left: auto;
    font-size: 0.7rem;
    color: var(--fg-4);
    letter-spacing: 0.06em;
  }

  /* ---- 下一届 ---- */
  .next {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 18px;
  }

  .next__card {
    display: grid;
    gap: 7px;
    padding: clamp(20px, 2.6vw, 30px);
    border: 1px solid var(--line);
    border-radius: var(--r-xs);
    background: var(--surface);
    transition: border-color var(--t), background-color var(--t);
  }

  .next__card:hover {
    border-color: var(--line-3);
    background: var(--surface-2);
  }

  .next__card :global(svg) {
    margin-top: 8px;
    color: var(--gold);
    transition: transform var(--t);
  }

  .next__card:hover svg {
    transform: translateX(3px);
  }

  .next__title {
    font-family: var(--font-display);
    font-size: 1.3rem;
    color: var(--fg);
  }

  .next__body {
    font-size: var(--step-small);
    color: var(--fg-2);
    line-height: 1.8;
  }

  @media (max-width: 900px) {
    .grid--3,
    .next {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 620px) {
    .grid--3,
    .next {
      grid-template-columns: 1fr;
    }
  }
</style>
