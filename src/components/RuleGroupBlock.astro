---
import SectionHead from './SectionHead.astro';
import type { RuleGroup } from '../data/submission';

interface Props {
  group: RuleGroup;
  /** 右侧补充说明 */
  note?: string;
}

const { group, note } = Astro.props;
---

<section class="section" id={group.id}>
  <SectionHead index={group.index} kicker={group.kicker} title={group.title} note={note} />

  <ol class="rules">
    {
      group.rules.map((r, i) => (
        <li class="rules__row">
          <span class="rules__no tnum">{String(i + 1).padStart(2, '0')}</span>
          <div class="rules__body">
            <h3 class="rules__title">{r.title}</h3>
            <p class="rules__detail">{r.detail}</p>
          </div>
        </li>
      ))
    }
  </ol>
</section>

<style>
  .rules {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--line);
  }

  .rules__row {
    display: grid;
    grid-template-columns: 56px minmax(0, 1fr);
    gap: 22px;
    padding: 22px 0;
    border-bottom: 1px solid var(--line);
  }

  .rules__no {
    font-family: var(--font-display);
    font-size: 0.95rem;
    letter-spacing: 0.06em;
    color: var(--gold-lo);
    padding-top: 3px;
  }

  .rules__title {
    font-size: 1.08rem;
    margin-bottom: 7px;
  }

  .rules__detail {
    font-size: var(--step-small);
    line-height: 1.95;
    color: var(--fg-2);
    max-width: 78ch;
  }

  @media (max-width: 560px) {
    .rules__row {
      grid-template-columns: 1fr;
      gap: 8px;
    }
  }
</style>
